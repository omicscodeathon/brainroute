.streamlit/secrets.toml
.streamlit/*.secrets.toml
.env

# macOS
.DS_Store
**/.DS_Store
*.code-workspace
logs/
.benchmark_workspaces/
brainroute_ml_validation/data/benchmarks/matched_3d_qm/cache/

# Jupyter
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Local plotting cache
brainroute_ml_validation/reports/.mplconfig/

# Python caches
__pycache__/
**/__pycache__/
*.pyc

# Legacy archive holds moved historical files. Tracked legacy files remain tracked,
# but local-only legacy extras should not be accidentally committed.
legacy/**/*

# BrainRoute validation model artifacts.
# Keep only the three deployed Streamlit models in Git/LFS; archive the rest separately.
brainroute_ml_validation/models/*.joblib
!brainroute_ml_validation/models/padel_morgan__lightgbm__duplicate_aware_seed5.joblib
!brainroute_ml_validation/models/padel_morgan__extra_trees__duplicate_aware_seed5.joblib
!brainroute_ml_validation/models/padel_morgan_embeddings__xgboost__scaffold_cv_fold1.joblib
